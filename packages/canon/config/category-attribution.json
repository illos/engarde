{
  "schemaVersion": 1,
  "schema": "engarde-category-attribution-v1",
  "status": "accepted",
  "description": "Category attribution by source location (DEC-0010). Buckets are MCDM's own 20 chapters \u2014 the designers' organization of the core books is the classification. Chapter chunks map to their own chapter; structured record families map to their home chapter, grounded where possible in the book's own topic index (the Ancestries chapter's 'Other Sections' navigation block names each topic's home chapter) and the source directory structure. User decision 2026-08-23: the review gate is WAIVED \u2014 attribution has no engine-blocking importance (nothing in the engine, grammar, or verification consumes buckets); it is organizational metadata, deterministic, and fine-tunable in one line when a product surface first consumes it. Rows noted REVIEW remain flagged for that future surface work.",
  "buckets": [
    "introduction",
    "the-basics",
    "making-a-hero",
    "ancestries",
    "background",
    "classes",
    "complications",
    "kits",
    "perks",
    "tests",
    "combat",
    "negotiation",
    "downtime-projects",
    "rewards",
    "gods-and-religion",
    "for-the-director",
    "monster-basics",
    "monsters",
    "retainers",
    "dynamic-terrain"
  ],
